# Copy this file to .env and fill in the real values.
# .env is gitignored. Never commit it.

# --- Neo4j (Aura) ---------------------------------------------------------
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-aura-password
NEO4J_DATABASE=neo4j

# --- LLM provider ---------------------------------------------------------
# groq     verified working, free tier is generous. Recommended.
# mistral  free tier is easy to exhaust; you WILL hit 429 code 1300.
# ollama   fully local, truly unlimited. Needs `ollama serve` running and
#          `pip install ollama`. Quality is lower on 4B models.
LLM_PROVIDER=groq

# Optional overrides. Leave unset to use the defaults in llm_config.py.
# KG_LLM_MODEL=openai/gpt-oss-120b     # extraction (kg_builder.py)
# CHAT_LLM_MODEL=openai/gpt-oss-20b    # chat (agent.py)
# LLM_MIN_INTERVAL=30.0                # seconds between extraction calls
#                                      # Groq default is 30s (8000 tokens/min).
#                                      # Setting it too low causes 429s.
# USE_STRUCTURED_OUTPUT=0              # must stay 0 for Groq (see below)

# --- Keys (only the one for your chosen provider is needed) ---------------
GROQ_API_KEY=your-groq-key
MISTRAL_API_KEY=your-mistral-key

# --- Ollama (only if LLM_PROVIDER=ollama) ---------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# --- Embeddings: NONE NEEDED ----------------------------------------------
# Embeddings run LOCALLY via sentence-transformers (all-MiniLM-L6-v2, 384-d).
# No API key, no rate limit, free to re-run and re-embed. Nothing here
# changes which provider you pick for the LLM.
#
# USE_STRUCTURED_OUTPUT must be 0 on Groq: its strict schema validator rejects
# the library's Neo4jGraph schema with
#     "`additionalProperties:false` must be set on every object"
# because the embedding_properties dict does not set it. The prompt-based JSON
# path works with every provider.
